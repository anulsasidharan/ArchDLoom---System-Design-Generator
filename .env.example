# -----------------------------------------------------------------------------
# Repo root — Docker Compose and shared defaults.
# Copy to `.env` in this directory (do not commit real secrets).
# See docs/ENVIRONMENT.md for full variable reference (Claude/OpenAPI/AWS).
# -----------------------------------------------------------------------------

POSTGRES_USER=archdloom
POSTGRES_PASSWORD=archdloom
POSTGRES_DB=archdloom
POSTGRES_PORT=5432

REDIS_PORT=6379

API_PORT=8000
WEB_PORT=3000

DATABASE_URL=postgresql://archdloom:archdloom@localhost:5432/archdloom
REDIS_URL=redis://localhost:6379/0

ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Claude / Anthropic — required for AI generation pipelines (Phase 2+).
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Backend app — optional overrides when not using Docker Compose defaults.
# -----------------------------------------------------------------------------
SECRET_KEY=change-me-in-production
CELERY_BROKER_URL=

# -----------------------------------------------------------------------------
# AWS S3 — optional; used for diagrams and downloadable bundles (later phases).
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Next.js (`frontend/` or root workspace install)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
